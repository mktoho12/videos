   "mouth": "0000001011111111110110011111011111111111000000000000000001111110000010000000000000000111110011111000000111111111100000"
  },
  {
   "scene": "S2",
   "speaker": "metan",
   "text": "業者って……網戸の穴よ？",
   "kana": "ギョ'オシャッテ、アミ'ドノ/アナ'ヨ？",
   "file": "003.wav",
   "durationSec": 1.931,
   "mouth": "0000111111111100011000000000111111111111111111111111110000"
  },
  {
