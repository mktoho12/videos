   "durationSec": 4.587,
   "mouth": "000011111100111110000111110110000000001111110111011100000000001000111100011111100000011111100111110000000000000000111011001110110111000000"
  },
  {
   "scene": "S2",
   "speaker": "tsumugi",
   "text": "ずんだもん先輩、やる前からあきらめてません？",
   "kana": "ズンダモンセ'ンパイ、ヤル'/マ'エカラ/アキラメテマセ'ン？",
   "file": "005.wav",
   "durationSec": 3.051,
   "mouth": "00001111111111110001110011111000000000000011111111111011111000011111110110110011110000000000"
  },
  {
   "scene": "S3",
